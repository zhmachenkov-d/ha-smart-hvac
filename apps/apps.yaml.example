# Copy to apps/apps.yaml and replace placeholder entity IDs with your house wiring.
# apps/apps.yaml is gitignored — do not commit live entity IDs.
hvac:
  module: hvac
  class: HvacApp
  outdoor_temperature: sensor.YOUR_OUTDOOR_TEMPERATURE
  plant_management: switch.YOUR_PLANT_MANAGEMENT
  plant_setpoint: number.YOUR_PLANT_SETPOINT
  setpoint_min: 40
  setpoint_max: 55
  control_interval: 60
  weather_feedforward:
    base: 25
    slope: 1.2
    comfort_ref: 20
  ladrc:
    b0: 2.8
    omega_o: 19.49
    omega_c: 0.053
    omega_c_min: 0.02
    omega_c_max: 0.15
    tune:
      ki: 0.005
      deadband: 0.2
      min_steady_ticks: 5
      max_rate_fraction: 0.05
  zones:
    - name: zone_one
      temperature: sensor.YOUR_ZONE_ONE_TEMPERATURE
      thermostats:
        - climate.YOUR_ZONE_ONE_THERMOSTAT
