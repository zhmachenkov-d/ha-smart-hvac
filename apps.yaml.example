# Copy to apps/apps.yaml (Exclusive Session) or beside ha_smart_hvac/ under AppDaemon
# app_dir (HACS/Production). Replace YOUR_* placeholders with house entity IDs.
# apps/apps.yaml is gitignored — do not commit live entity IDs.
hvac:
  module: ha_smart_hvac
  class: HvacApp
  outdoor_temperature: sensor.YOUR_OUTDOOR_TEMPERATURE
  plant_management: switch.YOUR_PLANT_MANAGEMENT
  plant_setpoint: number.YOUR_PLANT_SETPOINT
  setpoint_min: 40
  setpoint_max: 55
  control_interval: 60
  weather_feedforward:
    base: 25
    slope: 1.2
    comfort_ref: 20
  ladrc:
    b0: 5.0e-4
    omega_o: 0.03
    # Starting point for online ωc tune (ADR 0003); not the CAP-5 unit-test value.
    # Package A (тепло): cold-start |e|=2 stays under u_track_max; see house-calibration.
    omega_c: 0.03
    omega_c_min: 0.02
    omega_c_max: 0.15
    # Live magnitude guard (°C). 250 pairs with example ωc so |e|≲3 °C is tracking, not trip.
    u_track_max: 250
    tune:
      ki: 0.005
      deadband: 0.2
      min_steady_ticks: 5
      max_rate_fraction: 0.05
  zones:
    - name: zone_one
      temperature: sensor.YOUR_ZONE_ONE_TEMPERATURE
      thermostats:
        - climate.YOUR_ZONE_ONE_THERMOSTAT
