# Copy to .env and fill in values:
#   cp .env.example .env
#
# HA_* are read by ./scripts/run-appdaemon (regenerates appdaemon/secrets.yaml).
# GH_TOKEN is for the gh CLI inside the Dev Container. Set it in the *host*
# environment as well so containerEnv can inject it (or export it in the shell).

# Home Assistant — LAN URL that resolves from inside the Dev Container
# (e.g. http://192.168.1.10:8123). Exclusive Session: stop the Production
# AppDaemon add-on before ./scripts/run-appdaemon.
HA_URL=
HA_TOKEN=

# Optional: GitHub CLI (repo scope is enough for PRs and API calls).
# Git push uses SSH; this token is for gh only.
GH_TOKEN=
